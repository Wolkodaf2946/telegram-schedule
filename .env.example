# Скопируйте в .env и заполните. Обязательные поля отмечены (!).

# (!) Токен бота от @BotFather.
TELEGRAM_TOKEN=

# Если с сервера не открывается api.telegram.org (проверка: curl -m 15 https://api.telegram.org):
# прокси только для Telegram — сайт университета продолжит открываться напрямую.
# Поддерживаются http://, https://, socks5://, socks5h://
# TELEGRAM_PROXY=socks5://user:pass@proxy.example:1080
# Или свой адрес Bot API (self-hosted telegram-bot-api, зеркало).
# TELEGRAM_API_URL=https://api.telegram.org

# --- База данных ---
# (!) Используются контейнером Postgres в docker-compose. Пароль — без символов @ : / ? #,
# иначе его придётся URL-кодировать в DATABASE_URL.
POSTGRES_USER=schedule
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schedule
POSTGRES_PORT=5432

# Для запуска без Docker (make run). В docker-compose перекрывается автоматически.
DATABASE_URL=postgres://schedule:change-me@localhost:5432/schedule?sslmode=disable

# --- Расписание ---
# Группу каждый пользователь выбирает сам; обновляются только выбранные группы.
SCHEDULE_URL=https://schedule.siriusuniversity.ru
# Сколько месяцев после текущего загружать (0–6).
SYNC_MONTHS_AHEAD=1

# Часовой пояс университета: от него считаются «сегодня» и время обновлений.
TIMEZONE=Europe/Moscow
# Когда обновлять расписание: время через запятую, например 06:00,14:30.
# off — автообновления нет, только /refresh и `bot -sync-once`.
SYNC_TIMES=06:00
# Обновить сразу при старте, если данных нет или они старше суток.
SYNC_ON_START=true

# --- Доступ ---
# Telegram ID администраторов через запятую. Им приходят уведомления о новых
# пользователях и заявки, доступны /users, /allow, /revoke, /refresh.
# Свой ID можно узнать у @userinfobot.
ADMIN_IDS=
# open — бот открыт для всех;
# approval — новый пользователь после /start ждёт, пока администратор нажмёт
# «✅ Разрешить» в присланной ему заявке. Нужен хотя бы один ADMIN_IDS.
ACCESS_MODE=open
# В режиме approval эти пользователи получают доступ сразу, без заявки.
ALLOWED_USER_IDS=
# Писать администраторам «Бот запущен» при каждом запуске.
STARTUP_MESSAGE=true

# --- Логи ---
# debug | info | warn | error. На debug пишется каждый запрос к сайту расписания.
LOG_LEVEL=info
# JSON-лог в файл с ротацией (off — только консоль). В docker-compose — ./logs/bot.log.
LOG_FILE=logs/bot.log
LOG_MAX_SIZE_MB=20
LOG_MAX_BACKUPS=5
# Формат консоли: text (читать глазами) или json.
LOG_FORMAT=text
# Куда сохранять ответы сайта, которые не удалось разобрать (off — не сохранять).
DUMP_DIR=logs/dumps
# Отдельный журнал пользователей: новые (id, ник, имя, язык), заявки, решения админа.
USERS_LOG_FILE=logs/users.log
# Только для docker-compose: от какого пользователя хоста работает бот и кому принадлежат
# файлы в ./logs. Узнать на сервере: id -u и id -g.
HOST_UID=1000
HOST_GID=1000

# Если сайт расписания доступен только через прокси:
# HTTPS_PROXY=http://user:pass@proxy.example:3128
